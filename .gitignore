# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local configuration
.env
.env.*
!.env.example
.bridge_secret
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Secret/config backups — never commit
*.backup
*.backup_*
*.backup.*
*.bak
*.bak_*
*.bak.*
backup*/
*_backup*/

# Logs / runtime state
*.log
logs/
*.pid
*.sqlite
*.sqlite3
*.db
*.db.*
state/
runtime/

# Trading/runtime data that may contain account or strategy information
trades/
trade_history/
positions/
orders/
reports/private/
data/private/
data/raw/
data/*.db*
backtests/output/
artifacts/

# Local deployment overrides
deployment/*.env
deployment/*.conf

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Temporary files
*.tmp
*.swp
~*
