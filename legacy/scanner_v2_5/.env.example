# Bybit Scanner V2.5.1 — example configuration
BYBIT_REST_URL=https://api.bybit.com
QUOTE=USDT
BYBIT_MIN_REQUEST_INTERVAL_SEC=0.05
BYBIT_RETRY_429_BASE_SEC=1.0

SCAN_INTERVAL_SEC=30
UNIVERSE_REFRESH_SEC=1800
DEEP_CANDIDATES_PER_SCAN=24
DEEP_CONCURRENCY=6
MIN_24H_QUOTE_VOLUME=3000000
CORE_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,HYPE,LINK,SUI,AAVE,AVAX,ADA,BNB,PEPE
ROTATING_CANDIDATES=8

EARLY_ENABLED=true
HOTLIST_SIZE=8
HOT_MONITOR_SEC=7
HOT_CONCURRENCY=4
EARLY_VELOCITY_SEEDS=4
EARLY_MIN_BASE_SCORE=52
EARLY_ALERT_SCORE=62
EARLY_POTENTIAL_SCORE=72
EARLY_TRIGGER_DISTANCE_ATR=0.90
EARLY_POTENTIAL_DISTANCE_ATR=0.45
EARLY_MIN_PROJECTED_VOLUME=0.75
EARLY_POTENTIAL_PROJECTED_VOLUME=0.95
EARLY_POTENTIAL_MAX_SEC_TO_CLOSE=210
EARLY_CANCEL_MISSES=2
EARLY_REALERT_SEC=300

EXECUTE_SCORE=82
POTENTIAL_SCORE=70
MIN_RR_TP2=1.8
VOLUME_RATIO_TRIGGER=1.15
MAX_SPREAD_PCT=0.20
MAX_CHASE_ATR=1.30
SIGNAL_VALIDITY_SEC=900
SIGNAL_COOLDOWN_SEC=1800
SAME_CANDLE_COOLDOWN_SEC=600
CONTEXT_HARD_BLOCK=true

DYNAMIC_VALIDITY_ENABLED=true
DYNAMIC_VALIDITY_MIN_SEC=180
DYNAMIC_VALIDITY_MAX_SEC=1800

BYBIT_WS_PUBLIC_URL=wss://stream.bybit.com/v5/public/linear
ACTIVE_MONITOR_SEC=12
ACTIVE_CONTEXT_SEC=10
ACTIVE_CONTEXT_CONCURRENCY=2
REALTIME_EXCURSION_WRITE_SEC=5

SHADOW_ANTI_SL_ENABLED=true
SHADOW_SWING_LOOKBACK=7
SHADOW_BUFFER_ATR=0.20
SHADOW_MIN_STOP_ATR=0.65
SHADOW_MAX_STOP_ATR=1.60
SHADOW_MAX_5M_SPIKE_ATR=2.20
SHADOW_MAX_1M_SPIKE_ATR=0.65
SHADOW_MIN_ALIGNED_1M=2

PERFORMANCE_TRACK_SEC=3600
DB_PATH=data/bybit_crypto_scanner_v2.db

# Leave secrets empty in the committed example. Put real values only in .env.
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Bybit Trade Scanner
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=0
DISCORD_CONTROL_CHANNEL_ID=0
DISCORD_ALLOWED_USER_ID=0
LOG_LEVEL=INFO
