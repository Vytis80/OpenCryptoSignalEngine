# Bybit Scanner V2.6 — example configuration
# Copy to .env and provide your own Discord/bridge values locally. Never commit .env.
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_PUBLIC_URL=wss://stream.bybit.com/v5/public/linear
QUOTE=USDT
BYBIT_MIN_REQUEST_INTERVAL_SEC=0.06
BYBIT_RETRY_429_BASE_SEC=1.0

SCAN_INTERVAL_SEC=30
UNIVERSE_REFRESH_SEC=1800
DEEP_CANDIDATES_PER_SCAN=42
DEEP_CONCURRENCY=6
MIN_24H_QUOTE_VOLUME=3000000
CORE_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,HYPE,LINK,SUI,AAVE,AVAX,ADA,BNB,PEPE
ROTATING_CANDIDATES=20
MAX_DEEP_SCAN_AGE_SEC=360

EARLY_ENABLED=true
HOTLIST_SIZE=8
HOT_MONITOR_SEC=7
HOT_CONCURRENCY=4
EARLY_VELOCITY_SEEDS=4
EARLY_MIN_BASE_SCORE=52
EARLY_ALERT_SCORE=62
EARLY_POTENTIAL_SCORE=72
EARLY_TRIGGER_DISTANCE_ATR=0.90
EARLY_POTENTIAL_DISTANCE_ATR=0.45
EARLY_MIN_PROJECTED_VOLUME=0.75
EARLY_POTENTIAL_PROJECTED_VOLUME=0.95
EARLY_POTENTIAL_MAX_SEC_TO_CLOSE=210
EARLY_CANCEL_MISSES=2
EARLY_REALERT_SEC=300

EXECUTE_SCORE=82
POTENTIAL_SCORE=70
MIN_RR_TP2=1.8
VOLUME_RATIO_TRIGGER=1.15
MAX_SPREAD_PCT=0.20
MAX_CHASE_ATR=1.30
MIN_MICRO_CONFIRMATIONS=2
MIN_ATR5_PCT=0.06
MAX_ATR5_PCT=2.50
MAX_5M_RANGE_ATR=2.30
MIN_STOP_ATR=0.65
MAX_STOP_ATR=2.00
MIN_STOP_PCT=0.15
MAX_STOP_PCT=4.00
SIGNAL_VALIDITY_SEC=900
SIGNAL_COOLDOWN_SEC=1800
SAME_CANDLE_COOLDOWN_SEC=600
CONTEXT_HARD_BLOCK=true

DYNAMIC_VALIDITY_ENABLED=true
DYNAMIC_VALIDITY_MIN_SEC=180
DYNAMIC_VALIDITY_MAX_SEC=1800

ACTIVE_MONITOR_SEC=12
ACTIVE_CONTEXT_SEC=10
ACTIVE_CONTEXT_CONCURRENCY=2
REALTIME_EXCURSION_WRITE_SEC=5
MARKET_DATA_STALE_SEC=12
ACTIVE_CONTEXT_STALE_SEC=30
WS_WATCHDOG_SEC=8
ACTIVE_REST_FALLBACK_SEC=4
SAFETY_ALERT_GRACE_SEC=12

EST_FEE_PCT_PER_SIDE=0.055
EST_SLIPPAGE_PCT_PER_SIDE=0.010
EDGE_LOOKBACK_DAYS=90
EDGE_MIN_SAMPLE=30
EDGE_TP1_FRACTION=0.40
EDGE_TP2_FRACTION=0.30
EDGE_TP3_FRACTION=0.30

SHADOW_ANTI_SL_ENABLED=true
SHADOW_SWING_LOOKBACK=7
SHADOW_BUFFER_ATR=0.20
SHADOW_MIN_STOP_ATR=0.65
SHADOW_MAX_STOP_ATR=1.60
SHADOW_MAX_5M_SPIKE_ATR=2.20
SHADOW_MAX_1M_SPIKE_ATR=0.65
SHADOW_MIN_ALIGNED_1M=2

PERFORMANCE_TRACK_SEC=3600
DB_PATH=data/bybit_crypto_scanner_v2_6.db

# Secrets/account identifiers: keep empty/zero in the repository.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=0
DISCORD_CONTROL_CHANNEL_ID=0
DISCORD_ALLOWED_USER_ID=0
DISCORD_USERNAME=Bybit Trade Scanner
DISCORD_BOT_ENABLED=true
# merge mode upserts this scanner's commands without deleting unrelated commands in a shared Discord application.
DISCORD_COMMAND_SYNC_MODE=merge
DISCORD_COMMAND_AUDIT_SEC=60
DISCORD_RECONNECT_CAP_SEC=60
REQUIRE_DISCORD_WEBHOOK=true

# Optional Bybit Demo AutoTrader bridge. Leave empty to disable.
DEMO_BRIDGE_URL=
DEMO_BRIDGE_SECRET=

LOG_LEVEL=INFO

# Optional AI Judge second opinion (shadow-only; external Groq API)
AI_JUDGE_ENABLED=false
GROQ_API_KEY=your_groq_api_key
AI_JUDGE_MODEL=openai/gpt-oss-120b
AI_JUDGE_BASE_URL=https://api.groq.com/openai/v1
AI_JUDGE_TIMEOUT_SEC=5
AI_JUDGE_REASONING_EFFORT=low
