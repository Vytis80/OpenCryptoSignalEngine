# Bybit Demo AutoTrader — example configuration
# Create the API key in Bybit Demo Trading. Never use or commit a production key.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=

# Generate locally, for example: openssl rand -hex 32
BRIDGE_SECRET=
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787

DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=0
DISCORD_ADMIN_USER_IDS=

AUTO_TRADING_ENABLED=true
EXECUTION_MODE=SHADOW_MANUAL
RISK_PCT=1.0
LEVERAGE=10
MIN_MARGIN_USDT=100
MAX_OPEN_POSITIONS=20
MAX_MARGIN_FRACTION=0.35
MAX_NOTIONAL_USDT=0
ENTRY_TOLERANCE_PCT=0.10

SMART_MARGIN_ENABLED=true
SMART_MARGIN_BUFFER_STOP_FRACTION=0.20
SMART_MARGIN_MAX_EXTRA_RATIO=1.0
SMART_MARGIN_STEP_USDT=25
SMART_POSITION_SHADOW_ENABLED=true
SMART_POSITION_HISTORY_SEC=60
TP2_LOCK_SL_TO_TP1_ENABLED=true

TP1_FRACTION=0.40
TP2_FRACTION=0.30
TP3_FRACTION=0.30
SL_TRIGGER_BY=MarkPrice
TP_TRIGGER_BY=LastPrice
RECONCILE_SEC=3

DB_PATH=data/demo_trader.db
LOG_LEVEL=INFO
